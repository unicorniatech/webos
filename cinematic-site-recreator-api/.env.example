# ============================================================
#  cinematic-site-recreator-api — Environment Variables
#  Copia este archivo a .env y llena tus valores reales
#  NUNCA subas .env a git
# ============================================================

# ── Servidor ─────────────────────────────────────────────────
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ── Proveedor de análisis (auto / claude / openai) ───────────
# auto = usa Claude si está disponible, sino OpenAI, sino mock
AI_PROVIDER=auto

# ── Anthropic (Claude) ───────────────────────────────────────
# Obtén tu key en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── OpenAI ───────────────────────────────────────────────────
# Obtén tu key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...
# Modelo a usar (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# ── Google AI (Imagen 3 + Veo 2) ────────────────────────────
# Obtén tu key en: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=AIzaSy...

# ── Google Cloud (opcional — solo si usas Veo via Vertex AI) ─
# Requiere proyecto en: https://console.cloud.google.com/
GOOGLE_CLOUD_PROJECT=mi-proyecto-id
GOOGLE_CLOUD_REGION=us-central1
